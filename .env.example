# ============================================================
# AssetFlow Enterprise — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to Git
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USER=assetflow
DB_PASSWORD=assetflow_secret
DB_NAME=assetflow_enterprise

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
